# Build with --platform=linux/amd64; this image runs Windows x64 test programs.
FROM debian:trixie-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f
ARG WINE_VERSION=10.0~repack-6
RUN test "$(dpkg --print-architecture)" = amd64 && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        wine64="${WINE_VERSION}" libwine="${WINE_VERSION}" python3 openssl ca-certificates && \
    rm -rf /var/lib/apt/lists/*
ENV WINEARCH=win64 WINEPREFIX=/wineprefix WINEDEBUG=-all WINEDLLOVERRIDES=winemenubuilder.exe=d
WORKDIR /portable
