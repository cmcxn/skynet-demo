+static const char*
+_check_hostname(lua_State* L, int idx) {
+    size_t len;
+    if(lua_type(L, idx) != LUA_TSTRING) {
+        luaL_error(L, "client hostname is required");
+    }
+    const char* hostname = lua_tolstring(L, idx, &len);
+    if(len == 0 || len > 253 || strlen(hostname) != len || hostname[0] == '.' ||
+        strpbrk(hostname, "* /\\[]@?#%\t\r\n") != NULL) {
+        luaL_error(L, "invalid client hostname");
+    }
+    return hostname;
+}
+
+static void
+_set_client_hostname(lua_State* L, struct tls_context* tls_p, const char* hostname) {
+    X509_VERIFY_PARAM* param = SSL_get0_param(tls_p->ssl);
+    ASN1_OCTET_STRING* ip = a2i_IPADDRESS(hostname);
+    int ret;
+    SSL_set_hostflags(tls_p->ssl, X509_CHECK_FLAG_NO_PARTIAL_WILDCARDS);
+    if(ip) {
+        // IP literals must match an iPAddress SAN and must never be sent as SNI.
+        ret = SSL_set1_host(tls_p->ssl, NULL) == 1 &&
+            X509_VERIFY_PARAM_set1_ip(param, ASN1_STRING_get0_data(ip),
+                ASN1_STRING_length(ip)) == 1 &&
+            SSL_set_tlsext_host_name(tls_p->ssl, NULL) == 1;
+        ASN1_OCTET_STRING_free(ip);
+    } else {
+        // A colon in a non-IP identity means a port or malformed IPv6 address.
+        ret = strchr(hostname, ':') == NULL &&
+            X509_VERIFY_PARAM_set1_ip(param, NULL, 0) == 1 &&
+            SSL_set1_host(tls_p->ssl, hostname) == 1 &&
+            SSL_set_tlsext_host_name(tls_p->ssl, hostname) == 1;
+    }
+    if(!ret) {
+        // Never leave a partially configured verification identity usable.
+        _free_context(tls_p);
+        ERR_clear_error();
+        luaL_error(L, "failed to configure client hostname verification");
+    }
+}
