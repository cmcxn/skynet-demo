+local function tunnel(interface, origin, forward)
+    local authorization = forward.authorization and "Proxy-Authorization: "..forward.authorization.."\r\n" or ""
+    interface.write("CONNECT "..origin.connect_authority.." HTTP/1.1\r\nHost: "..
+        origin.connect_authority.."\r\n"..authorization.."\r\n")
+    local buffer = ""
+    -- Ignore a bounded number of informational responses, never a CONNECT body.
+    for _ = 1, 6 do
+        local boundary
+        while true do
+            boundary = buffer:find("\r\n\r\n", 1, true)
+            if boundary then
+                assert(boundary + 3 <= 8192, "Proxy CONNECT response headers too large")
+                break
+            end
+            assert(#buffer <= 8192, "Proxy CONNECT response headers too large")
+            local chunk = interface.read()
+            assert(chunk and #chunk > 0, "Proxy CONNECT response incomplete")
+            buffer = buffer .. chunk
+        end
+        local head, rest = buffer:sub(1, boundary + 3), buffer:sub(boundary + 4)
+        local statusline = head:match("^([^\r\n]+)\r\n")
+        local code = statusline and tonumber(statusline:match("^HTTP/1%.[01] (%d%d%d)%s.*$") or statusline:match("^HTTP/1%.[01] (%d%d%d)$"))
+        assert(code, "Invalid proxy CONNECT response")
+        if code >= 200 and code < 300 then return rest end
+        if code >= 200 or code == 101 then error("Proxy CONNECT failed (HTTP "..code..")", 0) end
+        buffer = rest
+    end
