diff --git a/vendor/skynet/lualib/http/proxy.lua b/lualib/http/proxy.lua
new file mode 100644
index 0000000..36d133b
--- /dev/null
+++ b/lualib/http/proxy.lua
@@ -0,0 +1,122 @@
+-- Deliberately supports HTTP forward proxies only. Configuration errors never
+-- fall back to direct egress, and diagnostics never include proxy credentials.
+local M = {}
+
+local function authority(value, default_port, message)
+    local host, port
+    if value:sub(1, 1) == '[' then
+        host, port = value:match('^%[([%x:%.]+)%]:(%d+)$')
+        if not host then host = value:match('^%[([%x:%.]+)%]$') end
+    else
+        host, port = value:match('^([%w%.%-_]+):(%d+)$')
+        if not host then host = value:match('^([%w%.%-_]+)$') end
+    end
+    port = port and tonumber(port) or default_port
+    assert(host and port and port >= 1 and port <= 65535, message)
+    return host, port
+end
+
+local function hostport(host, port)
+    return (host:find(':', 1, true) and '['..host..']' or host)..':'..port
+end
+
+function M.origin(value)
+    assert(type(value) == 'string', 'Invalid HTTP origin')
+    local scheme, rest = value:match('^([%a]+)://(.*)$')
+    local protocol = scheme and scheme:lower() or 'http'
+    assert(protocol == 'http' or protocol == 'https', 'Unsupported origin protocol')
+    local addr = rest or value
+    local host, port = authority(addr, protocol == 'https' and 443 or 80, 'Invalid HTTP origin')
+    return {protocol = protocol, host = host, port = port, authority = addr,
+        connect_authority = hostport(host, port)}
+end
+
+local function ipv4(s)
+    local a,b,c,d = s:match('^(%d+)%.(%d+)%.(%d+)%.(%d+)$')
+    if not a then return end
+    local n = 0
+    for _,v in ipairs{a,b,c,d} do
+        v = tonumber(v)
+        if v > 255 then return end
+        n = n * 256 + v
+    end
+    return n
+end
+
+local function bypass(origin, value)
+    local hostname = origin.host:lower():gsub('%.$', '')
+    for entry in (value or ''):gmatch('[^,]+') do
+        entry = entry:match('^%s*(.-)%s*$'):lower()
+        if entry == '*' then return true end
+        local network, bits = entry:match('^([%d%.]+)/(%d+)$')
+        if network then
+            local address, base = ipv4(hostname), ipv4(network)
+            bits = tonumber(bits)
+            if address and base and bits <= 32 and (address >> (32-bits)) == (base >> (32-bits)) then
+                return true
+            end
+        else
+            local host, port
+            if entry:sub(1,1) == '[' then
+                host, port = entry:match('^%[([^%]]+)%]:(%d+)$')
+                if not host then host = entry:match('^%[([^%]]+)%]$') end
+            else
+                host, port = entry:match('^([^:]+):(%d+)$')
+                host = host or entry
+            end
+            host = host and host:gsub('^%.', ''):gsub('%.$', '')
+            if host and host ~= '' and (not port or tonumber(port) == origin.port) then
+                if hostname == host then return true end
+                if not ipv4(hostname) and not hostname:find(':',1,true) and
+                    hostname:sub(-#host-1) == '.'..host then return true end
+            end
+        end
+    end
+    return false
+end
+
+local function decode(value)
+    assert(not value:gsub('%%%x%x',''):find('%%'), 'Invalid proxy credentials')
+    local result = value:gsub('%%(%x%x)', function(hex) return string.char(tonumber(hex,16)) end)
+    assert(not result:find('[%z\r\n]'), 'Invalid proxy credentials')
+    return result
+end
+
+local function parse(value)
+    assert(type(value) == 'string', 'Invalid HTTP proxy configuration')
+    local scheme, addr = value:match('^([%a][%w+.-]*)://(.*)$')
+    assert(scheme and scheme:lower() == 'http', 'Only http:// proxies are supported')
+    addr = addr:gsub('/$', '')
+    assert(not addr:find('[/\\?#%s%z]'), 'Invalid HTTP proxy configuration')
+    local credentials, endpoint = addr:match('^(.-)@([^@]+)$')
+    local authorization
+    if credentials then
+        local user, password = credentials:match('^([^:]*):(.*)$')
+        assert(user and not credentials:find('@',1,true), 'Invalid proxy credentials')
+        user, password = decode(user), decode(password)
+        assert(not user:find(':',1,true), 'Invalid proxy username')
+        authorization = 'Basic '..require('skynet.crypt').base64encode(user..':'..password)
+    end
+    local host, port = authority(endpoint or addr, 80, 'Invalid HTTP proxy endpoint')
+    return {host = host, port = port, authorization = authorization}
+end
+
+function M.select(origin, override, getenv)
+    if override == false then return end
+    getenv = getenv or os.getenv
+    local no_proxy = getenv('no_proxy')
+    if no_proxy == nil then no_proxy = getenv('NO_PROXY') end
+    if bypass(origin, no_proxy) then return end
+    local value = override
+    if value == nil then
+        value = getenv(origin.protocol .. '_proxy')
+        -- HTTP_PROXY is deliberately ignored: CGI may derive it from a request header.
+        if value == nil and origin.protocol == 'https' then value = getenv('HTTPS_PROXY') end
+        if value == nil then value = getenv('all_proxy') end
+        if value == nil then value = getenv('ALL_PROXY') end
+    end
+    if value == nil or value == '' then return end
+    return parse(value)
+end
+
+return M
